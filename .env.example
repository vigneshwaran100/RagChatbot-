# ─────────────────────────────────────────────
# RAG Chatbot — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Qdrant ───────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=rag_knowledge_base
# Optional: for cloud Qdrant
# QDRANT_API_KEY=your_qdrant_cloud_api_key
# QDRANT_URL=https://your-cluster.qdrant.io

# ── Embedding Model ──────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DEVICE=cpu           # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=32

# ── Chunking ─────────────────────────────────
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
SEMANTIC_SIMILARITY_THRESHOLD=0.75

# ── LLM Providers ────────────────────────────
# Primary: Groq
GROQ_API_KEY=xxx
GROQ_MODEL= openai/gpt-oss-20b

# Fallback 1: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Fallback 2: Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-haiku-20240307

# Fallback 3: Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Retrieval ────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.4

# ── Reliability ──────────────────────────────
# If best score < this, respond "information unavailable"
CONFIDENCE_THRESHOLD=0.4


# ── RAGAS Evaluation ─────────────────────────
# RAGAS uses an LLM judge internally (defaults to OpenAI).
# Set OPENAI_API_KEY above to enable full RAGAS scoring.
# Dataset and report paths (used by tests/evaluation/ragas_eval.py)
RAGAS_EVAL_DATASET=tests/evaluation/eval_dataset.json
RAGAS_REPORT_OUTPUT=tests/evaluation/eval_report.md

